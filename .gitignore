# Python temporary files
__pycache__/
*.py[cod]
*$py.class

# OS generated files
.DS_Store
Thumbs.db

# User output images
outputs/

# Task runner scripts
_run_*.py

# Credentials and secrets
.env
secrets.json
*.pem
*.key

# ---- 抽卡工作台（新系统） ----
# 运行时数据库与产物
data/*.db
data/*.db-*
data/outputs/
data/thumbs/
data/backups/
data/archive/
# 语义索引与本地模型权重：可重建、体积大，不进版本库
data/semantics/
data/models/
# 角色冷启动缩略图：由 scripts/import_character_thumbs.py 从外部 JSON 重建
data/char_thumbs/
logs/
*.log
*.bak

# 克隆的第三方词卡库
vendor/

# 虚拟环境
.venv/
venv/

# UI 截图验收产物（node scripts/ui_shot.mjs）
temp/

data/vocab/

# 前端第三方代码要进 git（例：frontend/vendor/vue.esm-browser.prod.js）。
# 根上的 vendor/ 是「本机依赖 / 模型权重」，不进 git；两者同名但性质不同，所以单独开例外。
!frontend/vendor/
!frontend/vendor/**

# 外部素材 / 大体积图库：本机数据，不进版本库（合计 ~18GB）
/艺术家智能选择/
/noobaiStyleCollection_v12/
/image_flat_by_month/
