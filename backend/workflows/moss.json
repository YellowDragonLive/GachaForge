{
  "_comment": "MOSS Image (Flux2 架构) workflow，源自 MOSS_Turbo_8step 工作流；$XXX 由 WorkflowSpec 注入。",
  "1": {
    "inputs": {
      "unet_name": "$CKPT",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "2": {
    "inputs": {
      "clip_name": "$CLIP",
      "type": "moss_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP"
    }
  },
  "3": {
    "inputs": {
      "vae_name": "$VAE"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "4": {
    "inputs": {
      "text": "$PROMPT",
      "clip": [
        "2",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Prompt)"
    }
  },
  "5": {
    "inputs": {
      "text": "$NEGATIVE",
      "clip": [
        "2",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Negative)"
    }
  },
  "6": {
    "inputs": {
      "width": "$WIDTH",
      "height": "$HEIGHT",
      "batch_size": 1
    },
    "class_type": "EmptyFlux2LatentImage",
    "_meta": {
      "title": "Empty Flux 2 Latent"
    }
  },
  "7": {
    "inputs": {
      "seed": "$SEED",
      "steps": "$STEPS",
      "cfg": "$CFG",
      "sampler_name": "$SAMPLER",
      "scheduler": "$SCHEDULER",
      "denoise": 1,
      "model": [
        "$MODEL_SRC",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "6",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "8": {
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "9": {
    "inputs": {
      "filename_prefix": "$PREFIX",
      "images": [
        "8",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
