{
  "id": "moss",
  "label": "MOSS Image (Flux2)",
  "capabilities": ["lora", "negative", "clip", "vae"],
  "result_nodes": ["9"],
  "params": {
    "CKPT": {"source": "profile", "key": "checkpoint"},
    "CLIP": {"source": "profile", "key": "clip", "default": "qwen3.5_9b_w4a8_gptq.safetensors"},
    "VAE": {"source": "profile", "key": "vae", "default": "flux2-vae_small.safetensors"},
    "PROMPT": {"source": "prompt"},
    "NEGATIVE": {"source": "negative"},
    "SEED": {"source": "seed"},
    "WIDTH": {"source": "profile", "key": "width", "default": 768},
    "HEIGHT": {"source": "profile", "key": "height", "default": 768},
    "STEPS": {"source": "profile", "key": "steps", "default": 8},
    "CFG": {"source": "profile", "key": "cfg", "default": 1},
    "SAMPLER": {"source": "profile", "key": "sampler", "default": "euler"},
    "SCHEDULER": {"source": "profile", "key": "scheduler", "default": "simple"},
    "MODEL_SRC": {"source": "lora_chain", "slot": "model", "default": "1"},
    "PREFIX": {"source": "prefix"}
  },
  "lora": {
    "class_type": "LoraLoaderModelOnly",
    "node_prefix": 100,
    "name_input": "lora_name",
    "model_input": "model", "model_slot": 0,
    "weight_model": "strength_model",
    "weight_clip": ""
  }
}
