{
  "_comment": "纯 ComfyUI 内置节点的 API 格式工作流。$XXX 由 ComfyClient 在提交前替换为真实参数；LoraLoader 链由代码动态插入。",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "$CKPT" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "$PROMPT", "clip": ["$CLIP_SRC", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "$NEGATIVE", "clip": ["$CLIP_SRC", 1] }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "$WIDTH", "height": "$HEIGHT", "batch_size": 1 }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "$SEED",
      "steps": "$STEPS",
      "cfg": "$CFG",
      "sampler_name": "$SAMPLER",
      "scheduler": "$SCHEDULER",
      "denoise": 1,
      "model": ["$MODEL_SRC", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "$PREFIX", "images": ["6", 0] }
  }
}
