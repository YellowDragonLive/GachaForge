# 复制为 .env 后按需修改；所有路径相对于项目根目录（X:/image）时会自动拼接
# 服务
GACHA_HOST=127.0.0.1
GACHA_PORT=8765
GACHA_LOG_LEVEL=INFO

# ComfyUI（直连）
GACHA_COMFY_URL=http://127.0.0.1:8188
# 1 = 不连 ComfyUI，用本地占位图跑通全链路（离线冒烟用）；真实出图改为 0
GACHA_COMFY_MOCK=0
GACHA_COMFY_TIMEOUT=900

# 数据目录
GACHA_DB_PATH=data/gacha.db
GACHA_OUTPUTS_DIR=data/outputs
GACHA_THUMBS_DIR=data/thumbs
GACHA_WORKFLOW_DIR=backend/workflows

# 词卡库（git clone https://github.com/sdbds/stable-diffusion-webui-wildcards.git vendor/...）
GACHA_WILDCARDS_DIR=vendor/stable-diffusion-webui-wildcards/wildcards

# 可选：设置后所有 /api 请求需带 X-Gacha-Token（本地默认免登录）
GACHA_TOKEN=
